# ─────────────────────────────────────────────
# NETWORK
# ─────────────────────────────────────────────
PRIVATE_KEY=
POLYGONSCAN_API_KEY=
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# ─────────────────────────────────────────────
# ROLE ADDRESSES (testnet Amoy)
# ─────────────────────────────────────────────
# CRITICAL ROLES — must be separate wallets:
DEFAULT_ADMIN_ADDRESS=0x2d6ecb55771f262f99f9df8163910b1968a7862f
UPGRADER_ADDRESS=0x15CA765a1D8ce75a8B419F7A79bDe38e7AaD95E0
MINTER_ADDRESS=0x5366053a98f10e8cded12af53aaa6afd33a14a5a
BURNER_ADDRESS=0xfCb48aDbb480376089921b0A65B5022cB7EC3588

# OPERATIONAL ROLES — dedicated wallet:
PAUSER_ADDRESS=0x518322969492b8e52ca5d2eb1bc6c0d2f45d5892
# SWEEPER esegue startNewCycle/sweepCustodyFee (operativo, hot wallet — vedi
# RUNBOOK_SWEEP.md): firma centinaia di tx per batch, separato da FEE_ADMIN
SWEEPER_ADDRESS=0x518322969492b8e52ca5d2eb1bc6c0d2f45d5892

# RESTRICTION ROLES — can share wallet on testnet:
FREEZER_ADDRESS=0xf86063dDDDC0b841Ff3FBBa8a4A5E524f3D164c1
BLOCKER_ADDRESS=0xf86063dDDDC0b841Ff3FBBa8a4A5E524f3D164c1

# CONFIGURATION ROLES — share with DEFAULT_ADMIN on testnet:
# FEE_ADMIN imposta i parametri di governance: transfer fee, custody fee,
# collector, treasury, esenzioni (v2.4.0 — split da FEE_MANAGER, vedi SWEEPER sopra)
FEE_ADMIN_ADDRESS=0x2d6ecb55771f262f99f9df8163910b1968a7862f
RECOVERER_ADDRESS=0x2d6ecb55771f262f99f9df8163910b1968a7862f

# RECIPIENTS:
# ⚠️ MAINNET: FEE_COLLECTOR e CUSTODY_TREASURY devono essere indirizzi DEDICATI
# e DISTINTI tra loro e dall'admin. Se FEE_COLLECTOR == mittente di un transfer,
# la transfer fee diventa un no-op (la fee resta al mittente, vedi Token.sol);
# vale lo stesso principio per evitare ambiguità sul collector.
FEE_COLLECTOR_ADDRESS=0x2d6ecb55771f262f99f9df8163910b1968a7862f
CUSTODY_TREASURY_ADDRESS=0x2d6ecb55771f262f99f9df8163910b1968a7862f
INITIAL_HOLDER_ADDRESS=0x2d6ecb55771f262f99f9df8163910b1968a7862f

# Indirizzo del multisig (es. Safe) verso cui trasferire la governance nel
# redeploy pulito pre-mainnet (scripts/roles/finalize_governance.ts +
# scripts/roles/accept_governance.ts per la fase 2, dopo il delay):
GOVERNANCE_ADMIN=

# Delay (secondi) imposto ad AccessControlDefaultAdminRules per il transfer
# di DEFAULT_ADMIN_ROLE (beginDefaultAdminTransfer -> attesa -> accept).
# Default 3 giorni; su mainnet è OBBLIGATORIO (nessun fallback silenzioso).
ADMIN_TRANSFER_DELAY_SECONDS=259200

# ─────────────────────────────────────────────
# TEST ADDRESSES (users WITHOUT roles)
# ─────────────────────────────────────────────
USER1_ADDRESS=0xB15a4A995050b5DdE912c1a948fF49b2a2E7d615
USER2_ADDRESS=0x35744Db4a90e39648C45921dd039168EeAa2B5cf

# ─────────────────────────────────────────────
# DEPLOY ADDRESSES (populated by deploy script)
# ─────────────────────────────────────────────
PROXY_ADDRESS=
IMPLEMENTATION_ADDRESS=

# ─────────────────────────────────────────────
# TOKEN CONFIGURATION
# ─────────────────────────────────────────────
TOKEN_NAME=IGE Token
TOKEN_SYMBOL=IGT
TOKEN_DECIMALS=18

# Initial supply in wei (10,000 tokens × 1e18):
INITIAL_SUPPLY=10000000000000000000000

# Transfer fee in basis points (1 = 0.01%, a carico del percorso: vedi SPEC).
# Cap on-chain = 100 (1%). 0 = disabilitata:
TRANSFER_FEE_BASIS_POINTS=1

# Custody fee in basis points (50 = 0.50%). Cap on-chain = 200 (2%). 0 = disabilitata:
CUSTODY_FEE_BASIS_POINTS=50
